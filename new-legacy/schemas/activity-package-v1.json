{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/activity-package-v1.json",
  "title": "Activity Package v1",
  "type": "object",
  "required": [
    "packageId",
    "packageVersion",
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "author",
    "contentHash",
    "activities"
  ],
  "properties": {
    "packageId": {"type": "string", "minLength": 1, "maxLength": 160},
    "packageVersion": {"type": "integer", "minimum": 1},
    "schemaVersion": {"const": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "author": {"type": "string"},
    "contentHash": {"type": "string", "pattern": "^fnv1a32:[0-9a-f]{8}$"},
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "activity-schema-v1.json"}
    }
  },
  "additionalProperties": true
}
