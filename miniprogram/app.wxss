@import "/styles/tokens.wxss";

page {
  min-height: 100%;
  background: var(--paper);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: var(--font-body);
  line-height: var(--line-body);
}

view, text, button, input, image, scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: var(--radius-sm);
  font-size: var(--font-body);
  line-height: 1;
}

button[class] {
  width: var(--button-width, auto);
  margin-left: 0;
  margin-right: 0;
}

button::after {
  border: 0;
}

.page-shell {
  background: var(--paper);
  color: var(--text);
  min-height: 100vh;
  padding: 0 var(--page-gutter) calc(var(--space-6) + env(safe-area-inset-bottom));
}

.nav-bar {
  display: flex;
  align-items: center;
  gap: 0;
  height: 44px;
  padding-right: 176rpx;
}

.nav-title {
  color: var(--ink);
  font-size: var(--font-nav);
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: 0;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.eyebrow {
  color: var(--muted);
  font-size: var(--font-meta);
  line-height: 1.45;
  letter-spacing: 2rpx;
}

.primary-button,
.secondary-button,
.quiet-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--touch-min);
  font-weight: 600;
}

.primary-button {
  background: var(--ink);
  color: var(--on-accent);
}

.secondary-button {
  border: 2rpx solid var(--ink);
  background: transparent;
  color: var(--ink);
}

.quiet-button {
  background: transparent;
  color: var(--ink);
}

.field {
  width: 100%;
  min-height: var(--touch-min);
  padding: 0 var(--space-4);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--text);
  font-size: var(--font-body);
}

.error-copy {
  margin-top: var(--space-3);
  color: var(--danger);
  font-size: var(--font-meta);
  line-height: 1.45;
}

.page-title {
  font-size: var(--font-display);
  font-weight: 650;
  line-height: var(--line-tight);
}

.section-title {
  font-size: var(--font-heading);
  font-weight: 620;
  line-height: var(--line-title);
}

.body-copy {
  font-size: var(--font-body);
  line-height: var(--line-body);
}

.meta-copy {
  font-size: var(--font-meta);
  line-height: 1.45;
}

.aligned-section {
  padding-top: var(--space-5);
}

/* Override button[class]'s reset: keep the touch target, not an extra visual gap. */
button.nav-back { --button-width: 80rpx; display: flex; flex: 0 0 80rpx; align-items: center; justify-content: center; width: 80rpx; height: 44px; margin-left: -16rpx; background: transparent; }
.inline-notice { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-3); padding: var(--space-2) var(--space-3); border-radius: 12rpx; background: var(--surface-quiet); color: var(--danger); font-size: var(--font-meta); line-height: 1.5; }
.inline-retry { display: flex; flex-shrink: 0; align-items: center; justify-content: center; min-height: 80rpx; padding: 0 var(--space-1); background: transparent; color: var(--ink); font-size: var(--font-meta); }
.mode-symbol { display: flex; flex: 0 0 44rpx; align-items: center; justify-content: center; }
.section-kicker { color: var(--clay); font-size: var(--font-meta); font-weight: 600; line-height: 1.45; }
button { font-family: inherit; font-weight: 400; }
button[disabled] { opacity: .55; }
button.payment-unavailable[disabled] { opacity: 1; background: var(--surface-quiet); color: var(--muted); }
@media (prefers-reduced-motion: reduce) { button, view { transition: none; animation: none; } }
