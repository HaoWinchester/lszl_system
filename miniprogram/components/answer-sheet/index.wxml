<view wx:if="{{open}}" class="sheet-mask" catchtouchmove="noop" bindtap="onClose">
  <view class="sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-head"><text>答题卡</text><button class="sheet-close" bindtap="onClose" aria-label="关闭答题卡">关闭</button></view>
    <view class="legend"><view class="legend-item"><view class="dot answered"></view><text>已答</text></view><view class="legend-item"><view class="dot marked"></view><text>已标记</text></view><view class="legend-item"><view class="dot current"></view><text>当前</text></view></view>
    <view class="sheet-grid">
      <button wx:for="{{items}}" wx:key="questionId" class="sheet-number {{item.state}} {{item.marked ? 'marked' : ''}}" data-index="{{index}}" bindtap="onSelect" aria-label="第 {{index + 1}} 题 {{item.label}}">{{index + 1}}</button>
    </view>
    <button class="complete" bindtap="onComplete">检查并交卷</button>
  </view>
</view>
