.sheet-mask { position: fixed; z-index: 30; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: var(--mask); }
.sheet { width: 100%; max-height: 76vh; padding: var(--space-2) var(--page-gutter) calc(var(--space-4) + env(safe-area-inset-bottom)); border-radius: var(--radius-md) var(--radius-md) 0 0; background: var(--surface); }
.sheet-handle { width: 64rpx; height: 8rpx; margin: 0 auto var(--space-3); border-radius: 4rpx; background: var(--border-strong); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; color: var(--ink); font-size: var(--font-heading); font-weight: 650; line-height: var(--line-title); }
.sheet-close { min-height: var(--touch-min); padding: 0 var(--space-1); background: transparent; color: var(--muted); font-size: var(--font-meta); }
.sheet-close::after, .sheet-number::after, .complete::after { border: 0; }
.legend { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); margin-top: var(--space-2); color: var(--muted); font-size: var(--font-meta); }
.legend-item { display: flex; align-items: center; gap: var(--space-1); }
.dot { display: inline-block; width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--line); }
.dot.answered { background: var(--success); }.dot.marked { background: var(--clay); }.dot.current { border: 2rpx solid var(--ink); background: transparent; }
.dot.pending { border: 2rpx dashed var(--ink); background: transparent; }
.sheet-scroll { max-height: 40vh; margin-top: var(--space-4); }
.sheet-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-2); }
.sheet-close, .sheet-number, .complete { display: flex; align-items: center; justify-content: center; }
.sheet-number { position: relative; min-height: var(--touch-min); border: 2rpx solid var(--line); border-radius: var(--radius-sm); background: var(--surface); color: var(--muted); font-size: var(--font-meta); }
.sheet-number.answered { border-color: var(--success); background: var(--success-soft); color: var(--ink); }
.sheet-number.wrong { border-color: var(--danger); background: var(--danger-soft); color: var(--danger); }
.sheet-number.pending { border-style: dashed; border-color: var(--ink); color: var(--ink); }
.sheet-number.current { border-color: var(--ink); box-shadow: inset 0 0 0 2rpx var(--ink); }
.sheet-number.marked::before { position: absolute; top: var(--space-1); right: var(--space-1); width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--clay); content: ""; }
.complete { --button-width: 100%; width: 100%; min-height: var(--touch-min); margin-top: var(--space-5); border-radius: var(--radius-sm); background: var(--ink); color: var(--on-accent); font-size: var(--font-body); font-weight: 650; }
