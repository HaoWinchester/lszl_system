.remediation { margin-top: var(--space-5); padding: var(--space-1) 0 var(--space-1) var(--space-3); border-left: 4rpx solid #b96347; }
.remediation-kicker { color: #b96347; font-size: var(--font-meta); font-weight: 650; letter-spacing: 2rpx; }
.answer-line, .knowledge-line { display: flex; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-3); font-size: var(--font-body); line-height: var(--line-body); }
.remediation-key { flex: 0 0 176rpx; color: var(--muted); }
.remediation-value { color: var(--ink); font-weight: 600; text-align: right; }
.remediation-copy { display: block; margin-top: var(--space-4); color: #263d36; font-size: var(--font-body); line-height: var(--line-question); }
