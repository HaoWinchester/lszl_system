.paper-row {
  display: flex;
  align-items: stretch;
  flex-direction: column;
  width: 100%;
  min-height: 224rpx;
  padding: var(--space-4) 0;
  border-bottom: 2rpx solid var(--line);
  border-radius: 0;
  background: transparent;
  color: var(--text);
  text-align: left;
}

.paper-row::after { border: 0; }

.paper-meta,
.paper-foot {
  display: flex;
  align-items: center;
}

.paper-meta { gap: var(--space-2); }

.subject,
.access {
  color: var(--muted);
  font-size: var(--font-meta);
  line-height: 1.45;
}

.access {
  padding-left: var(--space-2);
  border-left: 2rpx solid var(--line);
}

.access.member { color: var(--gold); }

.paper-title {
  margin-top: var(--space-2);
  color: var(--ink);
  font-size: var(--font-heading);
  font-weight: 650;
  line-height: var(--line-title);
}

.paper-copy {
  display: -webkit-box;
  overflow: hidden;
  margin-top: var(--space-1);
  color: var(--muted);
  font-size: var(--font-body);
  line-height: var(--line-body);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.paper-foot {
  gap: var(--space-3);
  margin-top: auto;
  padding-top: var(--space-3);
  color: var(--muted);
  font-size: var(--font-meta);
}

.arrow {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  margin-left: auto;
}

.arrow::after {
  position: absolute;
  top: 8rpx;
  right: 4rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid var(--ink);
  border-right: 3rpx solid var(--ink);
  content: "";
  transform: rotate(45deg);
}

.arrow-line {
  position: absolute;
  top: 15rpx;
  right: 5rpx;
  width: 24rpx;
  height: 3rpx;
  background: var(--ink);
}
