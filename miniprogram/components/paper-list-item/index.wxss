.paper-row {
  display: flex;
  align-items: stretch;
  flex-direction: column;
  width: 100%;
  min-height: 238rpx;
  padding: 30rpx 0 32rpx;
  border-bottom: 2rpx solid #d8d7cc;
  border-radius: 0;
  background: transparent;
  color: #243b35;
  text-align: left;
}

.paper-row::after { border: 0; }

.paper-meta,
.paper-foot {
  display: flex;
  align-items: center;
}

.paper-meta { gap: 16rpx; }

.subject,
.access {
  color: #718079;
  font-size: 23rpx;
  line-height: 1.4;
}

.access {
  padding-left: 16rpx;
  border-left: 2rpx solid #d8d7cc;
}

.access.member { color: #a78037; }

.paper-title {
  margin-top: 16rpx;
  color: #173b32;
  font-size: 33rpx;
  font-weight: 650;
  line-height: 1.4;
}

.paper-copy {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: #718079;
  font-size: 25rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.paper-foot {
  gap: 24rpx;
  margin-top: auto;
  padding-top: 22rpx;
  color: #718079;
  font-size: 24rpx;
}

.arrow {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  margin-left: auto;
}

.arrow::after {
  position: absolute;
  top: 9rpx;
  right: 5rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #173b32;
  border-right: 3rpx solid #173b32;
  content: "";
  transform: rotate(45deg);
}

.arrow-line {
  position: absolute;
  top: 16rpx;
  right: 6rpx;
  width: 23rpx;
  height: 3rpx;
  background: #173b32;
}
