.save-status { display: flex; align-items: center; gap: var(--space-1); color: var(--muted); font-size: var(--font-meta); line-height: 1.45; }
.save-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #9da59f; }
.save-status.saving .save-dot { background: var(--gold); }
.save-status.saved .save-dot { background: #497465; }
.save-status.offline .save-dot,
.save-status.conflict .save-dot { background: var(--clay); }
