<view class="question {{compact ? 'is-compact' : ''}}">
  <view class="question-kind"><text class="question-kind-label">{{displayQuestion.type === 'matching' ? '匹配题' : displayQuestion.type === 'unknown' ? '未支持题型' : displayQuestion.type === 'multiple_choice' ? '多选题' : '单选题'}}</text><text wx:if="{{displayQuestion.type === 'multiple_choice'}}">请选择所有正确选项</text></view>
  <view wx:if="{{displayQuestion.material}}" class="case-material"><button bindtap="toggleCase" aria-expanded="{{caseOpen}}">{{displayQuestion.material.title}} · {{caseOpen ? '收起材料' : '展开材料'}}</button><view wx:if="{{caseOpen}}"><text class="case-text">{{displayQuestion.material.text}}</text><image wx:for="{{materialImages}}" wx:key="id" src="{{item.src}}" mode="widthFix" class="question-image" data-src="{{item.src}}" bindtap="previewImage"/><text wx:if="{{displayQuestion.caseGroup}}">第 {{displayQuestion.caseGroup.order}} / {{displayQuestion.caseGroup.total}} 小题</text></view></view>
  <rich-text class="stem" nodes="{{displayQuestion.stemNodes}}"></rich-text>
  <text wx:if="{{displayQuestion.stemEn}}" class="stem-en">{{displayQuestion.stemEn}}</text>
  <view wx:if="{{displayQuestion.images.length}}" class="question-images">
    <image wx:for="{{displayQuestion.images}}" wx:key="*this" class="question-image" src="{{item}}" mode="widthFix" data-src="{{item}}" bindtap="previewImage" />
  </view>
  <view class="question-images"><view wx:for="{{assetImages}}" wx:key="id"><image class="question-image" src="{{item.src}}" mode="widthFix" data-src="{{item.src}}" bindtap="previewImage"/><text>{{item.alt}}</text></view><button wx:if="{{assetErrors.length}}" bindtap="retryAssets">图表加载失败，点击重试</button></view>
  <view wx:if="{{displayQuestion.type === 'matching'}}" class="matching"><text>先点条目，再点候选；候选可以重新分配。</text><view wx:for="{{pairRows}}" wx:key="id" class="matching-pair {{item.verdict}}"><button data-id="{{item.id}}" bindtap="chooseLeft" disabled="{{submitted}}" class="matching-target {{activeLeft === item.id ? 'active' : ''}}"><text>{{item.number}}. {{item.text}}</text><text class="matching-selection">{{item.selectedText}}</text></button><button wx:if="{{item.selectedId && !submitted}}" data-id="{{item.id}}" bindtap="clearPair" class="matching-clear">取消配对</button><text wx:if="{{item.verdict}}">正确配对：{{item.correctText}}</text></view><view wx:if="{{!submitted}}" class="matching-candidates"><button wx:for="{{displayQuestion.matching.right}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseRight">{{item.text}}</button></view><text aria-live="polite">{{matchingStatus}}</text></view>
  <view wx:if="{{displayQuestion.type === 'unknown'}}" role="alert">当前客户端不支持此题型，请更新后重试。</view>
  <view wx:if="{{displayQuestion.type !== 'matching' && displayQuestion.type !== 'unknown'}}" class="options">
    <button wx:for="{{displayOptions}}" wx:key="id" class="option {{item.selected ? 'is-selected' : ''}} {{submitted ? 'is-locked' : ''}} {{item.verdict ? 'is-' + item.verdict : ''}}" data-id="{{item.id}}" hover-class="{{submitted ? 'none' : 'option-pressed'}}" bindtap="onChoose" aria-disabled="{{submitted}}" aria-label="选项 {{item.id}} {{item.text}}" aria-checked="{{item.selected}}" role="{{displayQuestion.type === 'multiple_choice' ? 'checkbox' : 'radio'}}">
      <view class="option-key">{{item.id}}</view>
      <view class="option-copy"><text>{{item.text}}</text><text wx:if="{{item.textEn}}" class="option-en">{{item.textEn}}</text><text wx:if="{{item.verdict}}" class="option-verdict">{{item.verdict === 'correct' ? '正确选项' : '你的选择'}}</text></view>
    </button>
  </view>
  <view wx:if="{{showAnalysis}}" class="analysis">
    <text class="answer-outcome">{{outcome}}</text>
    <view class="answer-summary"><text>你的答案：{{selectedLabel}}</text><text>正确答案：{{answerLabel}}</text></view>
    <text class="analysis-label">解析</text>
    <text class="analysis-copy">{{displayQuestion.analysis || displayQuestion.explanation || '这道题尚未提供解析。'}}</text>
  </view>
</view>
