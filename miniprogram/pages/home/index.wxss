.home-page {
  padding-bottom: calc(154rpx + env(safe-area-inset-bottom));
}

.welcome {
  display: flex;
  flex-direction: column;
  padding-top: var(--space-6);
}

.home-title {
  margin-top: var(--space-2);
  color: var(--ink);
  font-size: var(--font-display);
  font-weight: 650;
  line-height: var(--line-tight);
}

.home-copy,
.section-copy {
  margin-top: var(--space-2);
  color: var(--muted);
  font-size: var(--font-body);
  line-height: var(--line-body);
}

.rule {
  height: 2rpx;
  margin: var(--space-6) 0 var(--space-5);
  background: var(--line);
}

.first-state {
  display: flex;
  flex-direction: column;
}

.continue-block { padding-bottom: var(--space-5); border-bottom: 2rpx solid var(--line); }
.continue-button { --button-width: 240rpx; width: 240rpx; margin-top: var(--space-3); }
.mode-section { padding-top: var(--space-5); }
.mode-row { --button-width: 100%; display: flex; align-items: center; width: 100%; min-height: 126rpx; border-bottom: 2rpx solid var(--line); border-radius: 0; background: transparent; text-align: left; }
.mode-row::after, .all-papers::after, .home-paper::after { border: 0; }
.mode-line { width: 6rpx; height: 56rpx; margin-right: var(--space-3); border-radius: 3rpx; background: var(--ink); }
.mode-line.clay { background: var(--clay); }
.mode-line.gold { background: var(--gold); }
.mode-body { display: flex; flex: 1; flex-direction: column; }
.mode-title { color: var(--ink); font-size: var(--font-heading); font-weight: 650; line-height: var(--line-title); }
.mode-copy { margin-top: var(--space-1); color: var(--muted); font-size: var(--font-meta); line-height: 1.45; }
.mode-arrow { width: 16rpx; height: 16rpx; margin-right: 6rpx; border-top: 3rpx solid var(--ink); border-right: 3rpx solid var(--ink); transform: rotate(45deg); }
.paper-heading-row { display: flex; align-items: center; justify-content: space-between; margin-top: var(--space-6); }
.all-papers { min-height: var(--touch-min); padding: 0 var(--space-1); background: transparent; color: var(--ink); font-size: var(--font-meta); text-decoration: underline; text-underline-offset: 5rpx; }
.home-papers { margin-top: var(--space-1); }
.home-paper { --button-width: 100%; display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 118rpx; border-bottom: 2rpx solid var(--line); border-radius: 0; background: transparent; text-align: left; }
.home-paper-body { display: flex; flex: 1; flex-direction: column; padding-right: var(--space-3); }
.home-paper-subject { color: var(--muted); font-size: var(--font-meta); }
.home-paper-title { margin-top: var(--space-1); color: var(--ink); font-size: var(--font-body); font-weight: 600; line-height: var(--line-body); }
.home-paper-count { color: var(--muted); font-size: var(--font-meta); }

.section-kicker {
  color: var(--clay);
  font-size: var(--font-meta);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.section-title {
  margin-top: var(--space-2);
  color: var(--ink);
  font-size: var(--font-heading);
  font-weight: 650;
  line-height: var(--line-title);
}

.loading-state {
  padding-top: var(--space-6);
}

.loading-line {
  width: 100%;
  height: 28rpx;
  margin-bottom: 30rpx;
  border-radius: 8rpx;
  background: var(--surface-quiet);
}

.loading-line.short {
  width: 38%;
}
