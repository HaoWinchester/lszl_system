<view class="page-shell growth-page tab-page" style="{{appearanceStyle}}padding-top: {{statusBarHeight}}px">
  <view class="nav-bar"><text class="nav-title">成长</text></view>
  <view wx:if="{{loading}}" class="growth-loading" aria-label="正在加载成长记录"><view class="growth-skeleton"></view><view class="growth-skeleton"></view><view class="growth-skeleton"></view></view>
  <empty-state wx:elif="{{!summary}}" title="成长记录没有载入" body="{{error}}" action-text="重新加载" bind:action="loadGrowth" />
  <block wx:else>
    <view class="growth-hero">
      <view class="hero-orbit" aria-hidden="true"><view class="orbit-inner"></view><view class="orbit-dot"></view></view>
      <text class="hero-eyebrow">把每一天，连成进步</text><view class="streak-display"><text class="streak-number">{{summary.currentStreak}}</text><text>天</text></view><text class="hero-caption">连续达标 · 最长 {{summary.longestStreak}} 天</text>
    </view>
    <view class="learning-card progress-card"><view class="growth-heading"><text class="section-title">今天的积累</text><text class="completion-label">{{summary.today.completed ? '已达标' : '进行中'}}</text></view><view class="progress-numbers"><text class="progress-number">{{summary.today.answered}}<text class="progress-denominator"> / {{summary.today.goal}} 题</text></text><text class="meta-copy">{{summary.today.completed ? '继续练习，巩固掌握' : '再答 ' + view.remaining + ' 题达标'}}</text></view><view class="growth-track"><view class="growth-fill" style="width: {{view.percent}}%"></view></view><button class="primary-button practice-button" bindtap="onPractice">去练习</button></view>
    <view wx:if="{{error}}" class="inline-notice" role="alert"><text>更新失败，保留上次记录：{{error}}</text><button class="inline-retry" bindtap="loadGrowth">重试</button></view>
    <view class="learning-card week-card"><view class="growth-heading"><text class="section-title">这一周</text><text class="meta-copy">达标 {{view.weekCompleted}} / 7 天</text></view><view class="week-calendar"><view wx:for="{{view.week}}" wx:key="date" class="week-day {{item.future ? 'is-future' : ''}}"><text class="weekday">{{item.weekday}}</text><view class="day-circle {{item.completed ? 'is-complete' : ''}} {{item.isToday ? 'is-today' : ''}}" aria-label="{{item.date + (item.completed ? ' 已达标' : item.future ? ' 尚未开始' : ' 已答 ' + item.answered + ' 题')}}"><text>{{item.completed ? '✓' : item.dayLabel}}</text></view><text class="day-caption">{{item.isToday ? '今天' : item.future ? '待启' : item.answered + '题'}}</text></view></view><text class="calendar-caption">本周已答 {{view.weekAnswered}} 题 · 按北京时间统计</text></view>
    <view class="learning-card goal-card"><view class="growth-heading"><text class="section-title">适合你的每日目标</text><ui-icon name="target" size="38" /></view><text class="goal-description">保持一点挑战，也给自己从容的空间。</text><view class="goal-options" role="radiogroup" aria-label="每日答题目标"><button wx:for="{{goals}}" wx:key="*this" class="goal-option {{selectedGoal === item ? 'selected' : ''}}" role="radio" aria-checked="{{selectedGoal === item}}" data-goal="{{item}}" bindtap="onGoal" disabled="{{saving}}"><text class="goal-number">{{item}}</text><text>题 / 天</text></button></view><text class="goal-notice">{{view.goalNotice}}</text><text wx:if="{{goalError}}" class="error-copy" role="alert">{{goalError}}</text><text wx:if="{{savedNotice}}" class="saved-notice" role="status">{{savedNotice}}</text><button class="secondary-button save-goal" loading="{{saving}}" disabled="{{saving || selectedGoal === summary.configuredGoal}}" bindtap="onSaveGoal">{{goalError ? '重试保存目标' : saving ? '正在保存' : '保存目标'}}</button></view>
    <view class="learning-card milestone-card"><view class="growth-heading"><text class="section-title">每一步，都算数</text><ui-icon name="growth" size="38" /></view><text class="goal-description">连续达标最长纪录，点亮成长里程碑。</text><view class="milestone-path"><view wx:for="{{view.milestones}}" wx:key="days" class="milestone {{item.unlocked ? 'unlocked' : ''}}"><view class="milestone-medal">{{item.days}}</view><text class="milestone-title">连续 {{item.days}} 天</text><text class="milestone-label">{{item.label}}</text></view></view><text class="calendar-caption">累计达标 {{summary.totalCompletedDays}} 天</text></view>
    <button class="history-entry learning-card" bindtap="onHistory"><view class="history-entry-copy"><text class="section-title">练习记录与报告</text><text class="goal-description">回看每一次练习，继续未完成的进度</text></view><ui-icon name="chevron" size="32" /></button>
    <text class="growth-rule">答题成功保存后自动累计；答错也计入，同一天同一道题只计一次。达成当日目标后，自动点亮当天记录。</text>
  </block>
</view>
<app-dialog id="app-dialog" style="{{appearanceStyle}}" />
