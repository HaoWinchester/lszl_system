.growth-hero { position: relative; overflow: hidden; margin-top: 24rpx; padding: 36rpx 36rpx 74rpx; border-radius: 36rpx; background: var(--forest); color: var(--forest-text); }
.hero-eyebrow, .hero-caption { position: relative; display: block; font-size: var(--font-meta); }.streak-display { position: relative; display: flex; align-items: baseline; gap: 16rpx; margin: 4rpx 0; }.streak-number { font-size: 104rpx; line-height: 1.25; font-weight: 650; font-variant-numeric: tabular-nums; }.hero-orbit { position: absolute; right: -30rpx; top: 10rpx; width: 280rpx; height: 280rpx; border: 2rpx solid #6d947b; border-radius: 50%; }.orbit-inner { position: absolute; inset: 48rpx; border: 2rpx solid #6d947b; border-radius: 50%; }.orbit-dot { position: absolute; top: 26rpx; left: 20rpx; width: 42rpx; height: 42rpx; border-radius: 50%; background: var(--orange); }
.progress-card { position: relative; margin: -42rpx 16rpx 24rpx; border: 2rpx solid var(--line); }.growth-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.completion-label { flex-shrink: 0; padding: 8rpx 16rpx; border-radius: 24rpx; background: var(--green-soft); color: var(--ink); font-size: var(--font-meta); }.progress-numbers { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8rpx; margin: 22rpx 0; color: var(--muted); }.progress-number { color: var(--ink); font-size: 48rpx; font-weight: 650; }.progress-denominator { color: var(--muted); font-size: var(--font-meta); font-weight: 400; }.practice-button { --button-width: 100%; margin-top: 28rpx; }
.week-card, .goal-card, .milestone-card { margin-top: 24rpx; }.week-calendar { display: flex; justify-content: space-between; gap: 6rpx; margin: 32rpx 0 22rpx; }.week-day { display: flex; align-items: center; flex: 1; min-width: 0; flex-direction: column; gap: 14rpx; }.weekday, .day-caption { color: var(--muted); font-size: var(--font-meta); }.day-circle { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border: 2rpx solid var(--line); border-radius: 50%; color: var(--ink); font-size: 26rpx; }.day-circle.is-complete { background: var(--forest); border-color: var(--forest); color: var(--forest-text); }.day-circle.is-today { border: 3rpx solid var(--ink); background: var(--green-soft); color: var(--ink); }.day-circle.is-today.is-complete { background: var(--forest); color: var(--forest-text); }.is-future .day-circle { border-style: dashed; color: var(--muted); }.calendar-caption { display: block; padding-top: 18rpx; border-top: 2rpx solid var(--line); color: var(--muted); font-size: var(--font-meta); line-height: 1.5; }
.goal-description, .goal-notice, .growth-rule { display: block; margin-top: 14rpx; color: var(--muted); font-size: var(--font-meta); line-height: 1.65; }.goal-options { display: flex; gap: 12rpx; margin: 24rpx 0; }.goal-option { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; min-height: 128rpx; border: 2rpx solid var(--line); border-radius: 22rpx; background: var(--surface); color: var(--muted); font-size: var(--font-meta); }.goal-number { color: var(--ink); font-size: 36rpx; font-weight: 650; }.goal-option.selected { border-color: var(--ink); background: var(--green-soft); color: var(--ink); }.save-goal { --button-width: 100%; margin-top: 24rpx; }.saved-notice { display: block; margin-top: 14rpx; color: var(--success); font-size: var(--font-meta); }
.milestone-path { display: flex; gap: 8rpx; padding: 28rpx 0; }.milestone { display: flex; align-items: center; flex: 1; min-width: 0; flex-direction: column; gap: 12rpx; }.milestone-medal { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border: 2rpx solid var(--line); border-radius: 28rpx; background: var(--surface-quiet); color: var(--muted); font-size: 34rpx; font-weight: 650; }.unlocked .milestone-medal { border-color: var(--orange); background: var(--orange); color: var(--on-orange); }.milestone-title { color: var(--ink); font-size: var(--font-meta); }.milestone-label { color: var(--muted); font-size: var(--font-meta); }.history-entry { --button-width: 100%; display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; text-align: left; white-space: normal; }.history-entry-copy { flex: 1; }.history-entry .section-title { display: block; }.growth-rule { padding: 14rpx 12rpx; }.growth-loading { padding-top: 40rpx; }.growth-skeleton { height: 160rpx; margin-bottom: 24rpx; border-radius: 32rpx; background: var(--surface-quiet); }
