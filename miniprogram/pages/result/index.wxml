<view class="page-shell result-page" style="{{appearanceStyle}}padding-top: {{statusBarHeight}}px">
  <view class="nav-bar"><button class="nav-back" bindtap="onBack" aria-label="返回练习记录"><ui-icon name="back" /></button><text class="nav-title">练习结果</text></view>

  <view wx:if="{{loading}}" class="result-loading"><view class="result-loading-line is-lead"></view><view class="result-loading-line"></view><view class="result-loading-line"></view></view>
  <view wx:elif="{{error}}" class="result-error">
    <text class="result-error-title">结果没有载入</text>
    <text class="result-error-copy">{{error}}</text>
    <button class="secondary-button" bindtap="loadResult">重新加载</button>
  </view>

  <block wx:else>
    <view class="result-heading">
      <text class="eyebrow">{{report.paperName || '本次练习'}}</text>
      <text class="result-conclusion">{{conclusion}}</text>
      <text wx:if="{{gameOutcome}}" class="result-conclusion">{{gameOutcome}}</text>
      <text wx:if="{{gameDetail}}" class="section-aside">{{gameDetail}}</text>
      <view class="accuracy-line"><text class="accuracy-number">{{accuracy}}</text><text class="accuracy-unit">%</text><text class="accuracy-label">正确率</text></view>
    </view>

    <view class="result-facts">
      <view class="result-fact"><text class="result-fact-value">{{score}}%</text><text class="result-fact-label">得分</text></view>
      <view class="result-fact with-divider"><text class="result-fact-value">{{report.counts.correct || 0}} / {{report.counts.total || 0}}</text><text class="result-fact-label">答对</text></view>
      <view class="result-fact with-divider"><text class="result-fact-value">{{duration}}</text><text class="result-fact-label">用时</text></view>
    </view>

    <view class="result-section">
      <text class="section-kicker">薄弱知识点</text>
      <text class="section-intro" wx:if="{{domains.length}}">从得分较低的领域开始复习。</text>
      <view wx:for="{{domains}}" wx:key="id" class="domain-row {{item.weak ? 'is-weak' : ''}}">
        <text>{{item.label}}</text><text class="domain-score">{{item.score}}%</text>
      </view>
      <text wx:if="{{!domains.length}}" class="section-empty">本次暂无可用的领域统计。</text>
    </view>

    <view class="result-section wrong-section">
      <view class="section-title-row"><text class="section-kicker">错题 {{wrongQuestions.length}} · 未答 {{unansweredCount}}</text><text class="section-aside">点开查看解析</text></view>
      <view class="review-filters"><button class="review-filter {{reviewFilter === 'wrong' ? 'active' : ''}}" data-filter="wrong" bindtap="onReviewFilter">错题与未答</button><button class="review-filter {{reviewFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="onReviewFilter">全部题目</button></view>
      <button wx:for="{{reviewItems}}" wx:key="questionId" class="wrong-row" data-index="{{index}}" bindtap="onReview">
        <text class="wrong-number">{{item.number}}</text>
        <text class="wrong-stem">{{item.question.stem}}</text>
        <view class="wrong-tail"><text class="wrong-status">{{item.status}}</text><ui-icon name="chevron" size="32" /></view>
      </button>
      <text wx:if="{{!reviewItems.length}}" class="section-empty">本次全部答对，也可以切换到全部题目回顾。</text>
    </view>

    <view class="next-actions">
      <button wx:if="{{wrongQuestions.length}}" class="primary-button next-action" bindtap="onRevenge">进入错题复习</button>
      <text wx:if="{{wrongQuestions.length}}" class="section-aside">进入全部待复习错题，按学习进度安排重答与验证。</text>
      <button class="secondary-button next-action" bindtap="onRetry">再练一次</button>
      <button class="quiet-button next-action" bindtap="onHome">回到首页</button>
    </view>
  </block>
</view>

<view wx:if="{{reviewOpen}}" class="review-mask" style="{{appearanceStyle}}" bindtap="onCloseReview">
  <view class="review-sheet" catchtap="noop">
    <view class="review-handle"></view>
    <view class="review-head"><text>第 {{reviewNumber}} 题</text><button class="review-close" bindtap="onCloseReview">关闭</button></view>
    <scroll-view scroll-y class="review-scroll">
      <question-view question="{{reviewQuestion}}" selected-ids="{{reviewSelectedIds}}" submitted="{{true}}" show-analysis="{{true}}" compact="{{true}}" />
    </scroll-view>
  </view>
</view>
<app-dialog id="app-dialog" style="{{appearanceStyle}}" />
