.history-page { padding-bottom: calc(154rpx + env(safe-area-inset-bottom)); }
.history-nav { gap: var(--space-2); padding-right: 176rpx; }
.history-heading { display: flex; flex-direction: column; padding: var(--space-6) 0 var(--space-5); }
.history-title { color: var(--ink); font-size: var(--font-display); font-weight: 650; line-height: var(--line-tight); }
.history-copy { margin-top: var(--space-2); color: var(--muted); font-size: var(--font-body); line-height: var(--line-body); }
.filters { display: flex; gap: var(--space-2); padding-bottom: var(--space-3); border-bottom: 2rpx solid var(--line); }
.history-filter { min-width: 112rpx; min-height: var(--touch-min); padding: 0 var(--space-3); border: 2rpx solid transparent; border-radius: var(--radius-sm); background: transparent; color: var(--muted); font-size: var(--font-body); }
.history-filter.active { border-color: var(--ink); color: var(--ink); }
.history-loading { padding-top: var(--space-4); }
.history-loading-line { height: 136rpx; border-bottom: 2rpx solid var(--line); }
.history-list { padding-top: var(--space-1); }
.history-row { position: relative; display: flex; align-items: flex-start; flex-direction: column; min-height: 208rpx; padding: var(--space-4) 144rpx var(--space-4) 0; border-bottom: 2rpx solid var(--line); }
.history-meta { display: flex; gap: var(--space-2); color: var(--muted); font-size: var(--font-meta); line-height: 1.45; }
.paper-name { display: -webkit-box; overflow: hidden; margin-top: var(--space-2); color: var(--ink); font-size: var(--font-heading); font-weight: 650; line-height: var(--line-title); -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.history-result { display: flex; gap: var(--space-2); margin-top: var(--space-2); color: var(--muted); font-size: var(--font-meta); }
.history-score { color: var(--clay); }
.history-action { position: absolute; right: 0; bottom: var(--space-4); min-width: 128rpx; min-height: var(--touch-min); border-bottom: 2rpx solid var(--ink); border-radius: 0; background: transparent; color: var(--ink); font-size: var(--font-meta); }
