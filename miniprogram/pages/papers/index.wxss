.papers-page { padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }

.nav-bar { gap: var(--space-2); padding-right: 176rpx; }

.back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: transparent;
}

.back::after { border: 0; }

.back-icon {
  width: 20rpx;
  height: 20rpx;
  border-bottom: 3rpx solid var(--ink);
  border-left: 3rpx solid var(--ink);
  transform: rotate(45deg);
}

.filters {
  width: calc(100vw - 72rpx);
  margin-top: var(--space-5);
  white-space: nowrap;
}

.filter {
  display: inline-flex;
  align-items: center;
  min-height: var(--touch-min);
  margin-right: var(--space-2);
  padding: 0 var(--space-3);
  border-radius: 38rpx;
  background: var(--surface-quiet);
  color: var(--muted);
  font-size: var(--font-meta);
}

.filter::after,
.access-filter::after { border: 0; }

.filter.is-active { background: var(--ink); color: #fffdf7; }

.access-filters {
  display: flex;
  gap: var(--space-4);
  margin-top: var(--space-3);
  border-bottom: 2rpx solid var(--line);
}

.access-filter {
  position: relative;
  min-height: var(--touch-min);
  border-radius: 0;
  background: transparent;
  color: var(--muted);
  font-size: var(--font-body);
}

.access-filter.is-active { color: var(--ink); font-weight: 650; }
.access-filter.is-active::before {
  position: absolute;
  right: 0;
  bottom: -2rpx;
  left: 0;
  height: 4rpx;
  background: var(--ink);
  content: "";
}

.paper-loading { padding-top: var(--space-3); }
.paper-skeleton { padding: var(--space-5) 0; border-bottom: 2rpx solid var(--line); }
.paper-skeleton-line { width: 100%; height: 24rpx; margin-bottom: var(--space-3); border-radius: 8rpx; background: var(--surface-quiet); }
.paper-skeleton-line.is-short { width: 30%; height: 18rpx; }
.paper-skeleton-line.is-medium { width: 55%; margin-bottom: 0; }
