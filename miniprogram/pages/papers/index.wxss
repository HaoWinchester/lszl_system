.papers-page { padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }

.nav-bar { gap: 14rpx; padding-right: 176rpx; }

.back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: transparent;
}

.back::after { border: 0; }

.back-icon {
  width: 20rpx;
  height: 20rpx;
  border-bottom: 3rpx solid var(--ink);
  border-left: 3rpx solid var(--ink);
  transform: rotate(45deg);
}

.filters {
  width: calc(100vw - 72rpx);
  margin-top: 40rpx;
  white-space: nowrap;
}

.filter {
  display: inline-flex;
  align-items: center;
  min-height: 76rpx;
  margin-right: 14rpx;
  padding: 0 28rpx;
  border-radius: 38rpx;
  background: var(--surface-quiet);
  color: var(--muted);
  font-size: 26rpx;
}

.filter::after,
.access-filter::after { border: 0; }

.filter.is-active { background: var(--ink); color: #fffdf7; }

.access-filters {
  display: flex;
  gap: 32rpx;
  margin-top: 28rpx;
  border-bottom: 2rpx solid var(--line);
}

.access-filter {
  position: relative;
  min-height: 74rpx;
  border-radius: 0;
  background: transparent;
  color: var(--muted);
  font-size: 25rpx;
}

.access-filter.is-active { color: var(--ink); font-weight: 650; }
.access-filter.is-active::before {
  position: absolute;
  right: 0;
  bottom: -2rpx;
  left: 0;
  height: 4rpx;
  background: var(--ink);
  content: "";
}

.paper-loading { padding-top: 22rpx; }
.paper-skeleton { padding: 40rpx 0; border-bottom: 2rpx solid var(--line); }
.paper-skeleton view { width: 100%; height: 24rpx; margin-bottom: 20rpx; border-radius: 8rpx; background: var(--surface-quiet); }
.paper-skeleton view:first-child { width: 30%; height: 18rpx; }
.paper-skeleton view:last-child { width: 55%; margin-bottom: 0; }
