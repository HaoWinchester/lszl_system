.papers-page { padding-bottom: calc(154rpx + env(safe-area-inset-bottom)); }

.back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: transparent;
}

.back::after { border: 0; }

.back-icon {
  width: 20rpx;
  height: 20rpx;
  border-bottom: 3rpx solid var(--ink);
  border-left: 3rpx solid var(--ink);
  transform: rotate(45deg);
}

.filters {
  width: 100%;
  margin-top: var(--space-5);
  white-space: nowrap;
}

.filter {
  display: inline-flex;
  align-items: center;
  min-height: var(--touch-min);
  margin-right: var(--space-2);
  padding: 0 var(--space-3);
  border-radius: 38rpx;
  background: var(--surface-quiet);
  color: var(--muted);
  font-size: var(--font-meta);
}

.filter::after,
.access-filter::after { border: 0; }

.filter.is-active { background: var(--ink); color: var(--on-accent); }

.access-filters {
  display: flex;
  gap: var(--space-4);
  margin-top: var(--space-3);
  border-bottom: 2rpx solid var(--line);
}

.access-filter {
  position: relative;
  min-height: var(--touch-min);
  border-radius: 0;
  background: transparent;
  color: var(--muted);
  font-size: var(--font-body);
}

.access-filter.is-active { color: var(--ink); font-weight: 650; }
.access-filter.is-active::before {
  position: absolute;
  right: 0;
  bottom: -2rpx;
  left: 0;
  height: 4rpx;
  background: var(--ink);
  content: "";
}

.paper-loading { padding-top: var(--space-3); }
.catalog-more { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-5) 0; }
.paper-skeleton { padding: var(--space-5) 0; border-bottom: 2rpx solid var(--line); }
.paper-skeleton-line { width: 100%; height: 24rpx; margin-bottom: var(--space-3); border-radius: 8rpx; background: var(--surface-quiet); }
.paper-skeleton-line.is-short { width: 30%; height: 18rpx; }
.paper-skeleton-line.is-medium { width: 55%; margin-bottom: 0; }

.catalog-heading { display: flex; flex-direction: column; gap: 12rpx; margin: 26rpx 0; color: var(--ink); }.catalog-copy { color: var(--muted); font-size: var(--font-meta); }.catalog-search { border-color: transparent; border-radius: 28rpx; }.mode-selector { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8rpx; margin-top: 24rpx; padding: 8rpx; border-radius: 28rpx; background: var(--surface-quiet); white-space: nowrap; }.catalog-mode { display: inline-flex; align-items: center; justify-content: center; min-height: var(--touch-min); padding: 0 24rpx; border-radius: 22rpx; background: transparent; color: var(--muted); font-size: var(--font-meta); }.catalog-mode.active { background: var(--forest); color: var(--forest-text); font-weight: 600; }.paper-list { margin-top: 24rpx; padding: 0 24rpx; border-radius: 32rpx; background: var(--surface); }.filters { margin-top: 24rpx; }

.catalog-mode { width:100%; margin:0; white-space:normal; }
.quick-notice { display:flex;flex-direction:column;gap:12rpx;margin-top:24rpx;padding:24rpx;border-radius:24rpx;background:var(--green-soft);font-size:var(--font-meta);line-height:1.6;color:var(--ink); }
.quick-title { font-size:var(--font-heading);font-weight:650; }

.quick-notice .text-action { min-height:var(--touch-min);padding:12rpx;background:transparent;color:var(--ink);font-size:var(--font-meta);text-align:left;line-height:1.5; }
