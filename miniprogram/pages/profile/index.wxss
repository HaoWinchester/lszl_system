.profile-page { padding-bottom: calc(154rpx + env(safe-area-inset-bottom)); }
.identity { display: flex; align-items: center; padding: var(--space-6) 0 var(--space-5); border-bottom: 2rpx solid var(--line); }
.avatar-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 96rpx; width: 96rpx; height: 96rpx; border: 2rpx solid var(--ink); border-radius: var(--radius-sm); background: var(--green-soft); color: var(--ink); }
.avatar-letter { font-size: var(--font-question); font-weight: 650; line-height: 1; }
.identity-copy { display: flex; min-width: 0; margin-left: var(--space-4); flex-direction: column; }
.profile-name { overflow: hidden; margin-top: var(--space-1); color: var(--ink); font-size: var(--font-display); font-weight: 650; line-height: var(--line-tight); text-overflow: ellipsis; white-space: nowrap; }
.profile-username { overflow: hidden; margin-top: var(--space-1); color: var(--muted); font-size: var(--font-meta); line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.profile-section { padding-top: var(--space-5); }
.learning-facts { display: flex; margin-top: var(--space-3); padding: var(--space-4) 0; border-top: 2rpx solid var(--line); border-bottom: 2rpx solid var(--line); }
.learning-fact { display: flex; align-items: center; flex: 1; min-width: 0; flex-direction: column; text-align: center; }
.learning-fact.with-divider { border-left: 2rpx solid var(--line); }
.learning-value { color: var(--ink); font-size: 34rpx; font-variant-numeric: tabular-nums; font-weight: 650; }
.learning-label { margin-top: var(--space-1); color: var(--muted); font-size: var(--font-meta); }
.account-row, .logout { --button-width: 100%; display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: var(--touch-min); border-bottom: 2rpx solid var(--line); border-radius: 0; background: transparent; color: var(--ink); font-size: var(--font-body); text-align: left; }
.row-arrow { width: 15rpx; height: 15rpx; margin-right: 5rpx; border-top: 3rpx solid var(--muted); border-right: 3rpx solid var(--muted); transform: rotate(45deg); }
.account-section .logout { justify-content: flex-start; margin-top: var(--space-3); border-bottom: 0; color: var(--clay); }
.profile-loading { padding-top: var(--space-6); }
.profile-loading-line { height: 32rpx; margin-bottom: var(--space-4); border-radius: 8rpx; background: var(--surface-quiet); }
.profile-loading-line.is-lead { width: 42%; height: 76rpx; }
.info-row, .account-row { gap: var(--space-2); }
.expiry-value { white-space: normal; overflow-wrap: anywhere; padding: var(--space-2) 0; font-variant-numeric: tabular-nums; }
.membership-entry { margin-top: var(--space-3); font-weight: 600; }

.identity { margin-top: 24rpx; padding: 32rpx; border-radius: 32rpx 32rpx 0 0; border-bottom: 0; background: var(--forest); color: var(--forest-text); }.identity .eyebrow, .profile-username { color: #c9ddcf; }.profile-name { color: var(--forest-text); }.avatar-mark { flex-basis: 88rpx; width: 88rpx; height: 88rpx; border-radius: 28rpx; background: var(--mint); color: var(--on-mint); border-color: transparent; }.identity-copy { margin-left: 24rpx; }.membership-summary { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 20rpx 28rpx; border-radius: 0 0 32rpx 32rpx; background: var(--mint); color: var(--on-mint); }.membership-summary-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 8rpx; }.membership-title { font-size: var(--font-body); font-weight: 600; }.membership-copy { font-size: var(--font-meta); line-height: 1.5; }.membership-link { display: flex; align-items: center; flex-shrink: 0; min-height: var(--touch-min); background: transparent; color: var(--on-mint); font-size: var(--font-meta); }.profile-section { margin-top: 24rpx; padding: 28rpx; border-radius: 32rpx; background: var(--surface); }.learning-facts { margin-top: 18rpx; padding: 18rpx 0 0; border: 0; }.profile-heading { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }.sync-label { color: var(--muted); font-size: var(--font-meta); }.account-row:last-child { border-bottom: 0; }.account-section .section-kicker { display: block; padding-bottom: 8rpx; color: var(--muted); }.row-label { display: flex; align-items: center; gap: 18rpx; }
