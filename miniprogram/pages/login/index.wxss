.login-page {
  display: flex;
  flex-direction: column;
}

.intro {
  display: flex;
  flex-direction: column;
  padding-top: var(--space-6);
}

.headline {
  margin-top: var(--space-2);
  color: var(--ink);
  font-size: var(--font-display);
  font-weight: 650;
  line-height: var(--line-tight);
}

.intro-copy {
  max-width: 610rpx;
  margin-top: var(--space-3);
  color: var(--muted);
  font-size: var(--font-body);
  line-height: var(--line-body);
}

.wechat-button {
  margin-top: var(--space-6);
  --button-width: 100%;
  width: 100%;
}

.binding-panel {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-top: var(--space-6);
}

.binding-tabs {
  display: flex;
  gap: var(--space-4);
  margin-bottom: var(--space-1);
  border-bottom: 2rpx solid var(--line);
}

.binding-tab {
  position: relative;
  min-height: var(--touch-min);
  border-radius: 0;
  background: transparent;
  color: var(--muted);
  font-size: var(--font-body);
}

.binding-tab.is-active {
  color: var(--ink);
  font-weight: 650;
}

.binding-tab.is-active::before {
  position: absolute;
  right: 0;
  bottom: -2rpx;
  left: 0;
  height: 4rpx;
  background: var(--ink);
  content: "";
}

.submit-button {
  margin-top: var(--space-2);
  --button-width: 100%;
  width: 100%;
}

.legal-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
  margin-top: auto;
  padding: var(--space-5) 0 var(--space-1);
}

.check {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-top: 2rpx;
  border: 2rpx solid #9ba49f;
  border-radius: 10rpx;
}

.check.is-checked {
  border-color: var(--ink);
  background: var(--ink);
}

.check-mark {
  width: 14rpx;
  height: 8rpx;
  border-bottom: 3rpx solid #fff;
  border-left: 3rpx solid #fff;
  transform: rotate(-45deg) translateY(-2rpx);
}

.legal-copy {
  color: var(--muted);
  font-size: var(--font-meta);
  line-height: var(--line-body);
}

.legal-link {
  color: var(--ink);
  text-decoration: underline;
  text-underline-offset: 5rpx;
}
