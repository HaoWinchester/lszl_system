<view class="page-shell setup-page" style="{{appearanceStyle}}padding-top: {{statusBarHeight}}px">
  <view class="nav-bar">
    <button class="nav-back" bindtap="onBack" aria-label="返回"><ui-icon name="back" /></button>
    <text class="nav-title">练习设置</text>
  </view>

  <view class="paper-heading">
    <text class="eyebrow">本次练习</text>
    <text class="setup-title">{{title}}</text>
    <text class="setup-meta">全卷 {{totalCount}} 题</text>
    <text class="setup-meta">优先练未做题，不足所选题量时用已做题补足；案例题保留完整。全部做过后进入复习。</text>
  </view>

  <text wx:if="{{error}}" class="error-copy" role="alert">{{error}}</text>
  <view wx:if="{{existingSessionId}}" class="resume-notice" role="status">
    <text class="line-title">已有未完成练习</text>
    <text class="line-copy">继续练习会沿用上次的题目和设置，不应用下方设置。若要更换题目或设置，请明确重新开始。</text>
    <button class="quiet-button restart-button" disabled="{{starting}}" bindtap="onRestartExisting">放弃上次并重新开始</button>
  </view>
  <view class="setting-section">
    <text class="setting-label">题量</text>
    <view class="choice-row">
      <button wx:for="{{countChoices}}" wx:key="value" class="choice {{count === item.value ? 'is-active' : ''}}" data-value="{{item.value}}" bindtap="onCount">{{item.label}}</button>
    </view>
  </view>

  <view class="setting-section">
    <text class="setting-label">出题顺序</text>
    <view class="option-list">
      <button class="line-option {{order === 'paper' ? 'is-active' : ''}}" data-order="paper" bindtap="onOrder">
        <view class="line-option-copy"><text class="line-title">顺序出题</text><text class="line-copy">未做题优先，按试卷顺序选题</text></view><view class="radio"><view wx:if="{{order === 'paper'}}" class="radio-dot"></view></view>
      </button>
      <button class="line-option {{order === 'random' ? 'is-active' : ''}}" data-order="random" bindtap="onOrder">
        <view class="line-option-copy"><text class="line-title">随机出题</text><text class="line-copy">未做题优先，随机选题</text></view><view class="radio"><view wx:if="{{order === 'random'}}" class="radio-dot"></view></view>
      </button>
    </view>
  </view>

  <view class="setting-section">
    <text class="setting-label">练习方式</text>
    <view class="mode-list">
      <button wx:for="{{modes}}" wx:key="id" class="mode-option {{mode === item.id ? 'is-active' : ''}}" data-mode="{{item.id}}" bindtap="onMode">
        <view class="mode-symbol"><ui-icon name="{{item.id}}" size="40" /></view>
        <view class="mode-text"><text class="line-title">{{item.title}}</text><text class="line-copy">{{item.copy}}</text></view>
        <view class="radio"><view wx:if="{{mode === item.id}}" class="radio-dot"></view></view>
      </button>
    </view>
  </view>


  <view class="setup-action-dock">
    <view class="setup-summary" role="status">
      <text class="summary-selection">{{existingSessionId ? '重新开始将使用：' : ''}}<text wx:for="{{modes}}" wx:key="id" wx:if="{{mode === item.id}}">{{item.title}}</text> · {{count}} 题 · {{order === 'random' ? '随机出题' : '顺序出题'}}</text>
      <text class="summary-priority">未做题优先 · 不足时补已做题 · 案例题保留完整</text>
    </view>
    <button class="primary-button start-button" loading="{{starting}}" disabled="{{starting}}" bindtap="start">{{existingSessionId ? '继续上次练习' : '开始练习'}}</button>
  </view>
</view>
<app-dialog id="app-dialog" style="{{appearanceStyle}}" />
