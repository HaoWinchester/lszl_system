.setup-page { padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom)); }
.nav-bar { gap: var(--space-2); padding-right: 176rpx; }
.back { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 50%; background: transparent; }
.back::after, .choice::after, .line-option::after, .mode-option::after { border: 0; }
.back-icon { width: 20rpx; height: 20rpx; border-bottom: 3rpx solid var(--ink); border-left: 3rpx solid var(--ink); transform: rotate(45deg); }
.paper-heading { display: flex; flex-direction: column; padding: var(--space-5) 0; border-bottom: 2rpx solid var(--line); }
.setup-title { margin-top: var(--space-2); color: var(--ink); font-size: var(--font-display); font-weight: 650; line-height: var(--line-tight); }
.setup-meta { margin-top: var(--space-2); color: var(--muted); font-size: var(--font-meta); line-height: 1.45; }
.setting-section { padding-top: var(--space-6); }
.setting-label { color: var(--ink); font-size: var(--font-heading); font-weight: 650; line-height: var(--line-title); }
.choice-row { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
.choice { min-width: 120rpx; min-height: var(--touch-min); padding: 0 var(--space-3); border: 2rpx solid var(--line); background: var(--surface); color: var(--muted); font-size: var(--font-body); }
.choice.is-active { border-color: var(--ink); background: var(--green-soft); color: var(--ink); }
.option-list, .mode-list { margin-top: var(--space-2); border-top: 2rpx solid var(--line); }
.line-option, .mode-option { display: flex; align-items: center; width: 100%; min-height: var(--option-min); padding: var(--space-3) 0; border-bottom: 2rpx solid var(--line); border-radius: 0; background: transparent; text-align: left; }
.line-option > view:first-child, .mode-text { display: flex; flex: 1; flex-direction: column; }
.line-title { color: var(--ink); font-size: var(--font-body); font-weight: 600; line-height: var(--line-title); }
.line-copy { margin-top: var(--space-1); color: var(--muted); font-size: var(--font-meta); line-height: 1.45; }
.radio { display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; margin-left: 24rpx; border: 2rpx solid #98a19d; border-radius: 50%; }
.radio view { width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--ink); }
.mode-mark { width: 8rpx; height: 64rpx; margin-right: var(--space-3); border-radius: 4rpx; background: var(--ink); }
.mode-mark.clay { background: var(--clay); }
.mode-mark.gold { background: var(--gold); }
.start-button { width: 100%; margin-top: var(--space-6); }
