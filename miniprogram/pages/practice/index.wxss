.practice-page { padding-bottom: calc(154rpx + env(safe-area-inset-bottom)); }
.practice-nav { display: flex; align-items: center; height: 88rpx; }
.exit, .sheet-entry, .mark-button, .previous, .submit { display: flex; align-items: center; justify-content: center; }
.exit { position: relative; width: 72rpx; height: 72rpx; border-radius: 50%; background: transparent; }
.exit::after, .sheet-entry::after, .mark-button::after, .previous::after, .submit::after { border: 0; }
.exit-line { position: absolute; width: 29rpx; height: 3rpx; background: var(--ink); }.exit-line.first { transform: rotate(45deg); }.exit-line.second { transform: rotate(-45deg); }
.progress-copy { display: flex; flex: 1; align-items: center; justify-content: center; gap: var(--space-2); color: var(--muted); font-size: var(--font-meta); line-height: 1.45; white-space: nowrap; }.progress-mode { flex-shrink: 0; color: var(--ink); font-weight: 600; }
.progress-copy .timer { min-width: 76rpx; color: var(--ink); font-variant-numeric: tabular-nums; }
.progress-copy .timer.urgent { color: var(--clay); font-weight: 650; }
.sheet-entry { display: grid; grid-template-columns: repeat(2, 12rpx); gap: 7rpx; width: 72rpx; height: 72rpx; border-radius: 50%; background: transparent; }.sheet-dot { width: 12rpx; height: 12rpx; border: 2rpx solid var(--ink); border-radius: 3rpx; }
.progress-track { height: 5rpx; overflow: hidden; background: var(--surface-quiet); }.progress-value { height: 100%; background: var(--ink); transition: width .2s ease; }
.progress-value.clay { background: var(--clay); }
.progress-value.gold { background: var(--gold); }
.practice-meta { display: flex; align-items: center; justify-content: space-between; padding-top: var(--space-2); }
.mark-button { min-height: var(--touch-min); padding: 0 var(--space-1) 0 var(--space-3); background: transparent; color: var(--muted); font-size: var(--font-meta); }.mark-button.is-marked { color: var(--clay); }
.question-loading { padding-top: 62rpx; }.question-loading-line { height: 28rpx; margin-bottom: 28rpx; border-radius: 8rpx; background: var(--surface-quiet); }.question-loading-line.is-short { width: 30%; height: 18rpx; }.question-loading-line.is-block { height: 122rpx; }
.write-error { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-top: var(--space-4); padding: var(--space-3) 0; border-top: 2rpx solid var(--line); color: var(--danger); font-size: var(--font-meta); }
.write-error-copy { flex: 1; }
.write-error-action { min-width: 160rpx; min-height: var(--touch-min); border-bottom: 2rpx solid var(--ink); border-radius: 0; background: transparent; color: var(--ink); font-size: var(--font-meta); }
.answer-actions { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; gap: var(--space-2); padding: var(--space-3) var(--page-gutter) calc(var(--space-3) + env(safe-area-inset-bottom)); border-top: 2rpx solid var(--line); background: var(--paper); }
.previous { flex: 0 0 176rpx; min-height: var(--touch-min); border: 2rpx solid var(--ink); background: transparent; color: var(--ink); font-size: var(--font-body); }.previous.is-disabled { border-color: var(--line); color: #a5aaa6; }
.submit { flex: 1; min-height: var(--touch-min); background: var(--ink); color: #fffdf7; font-size: var(--font-body); font-weight: 650; }.submit.is-disabled { background: #aeb8b2; color: #f7f5ef; }
