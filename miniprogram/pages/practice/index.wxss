.practice-page { padding-bottom: calc(154rpx + env(safe-area-inset-bottom)); }
.game-status { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); padding: var(--space-2) 0; border-bottom: 2rpx solid var(--line); color: var(--muted); font-size: var(--font-meta); }
.setting-toggle { display: flex; align-items: center; gap: var(--space-1); min-height: var(--touch-min); color: var(--muted); font-size: var(--font-meta); white-space: nowrap; }
.setting-switch-slot { position: relative; flex: none; width: 38px; height: 24px; }
.setting-switch { position: absolute; top: 50%; left: 0; transform: translateY(-50%) scale(0.7); transform-origin: left center; }
.answer-feedback { display: block; margin-top: var(--space-2); color: var(--ink); font-size: var(--font-meta); }
.practice-nav { display: flex; align-items: center; height: 44px; }
.exit, .sheet-entry, .mark-button, .previous, .submit { display: flex; align-items: center; justify-content: center; }
.exit { position: relative; width: 72rpx; height: 72rpx; border-radius: 50%; background: transparent; }
.exit::after, .sheet-entry::after, .mark-button::after, .previous::after, .submit::after { border: 0; }
.exit-line { position: absolute; width: 29rpx; height: 3rpx; background: var(--ink); }.exit-line.first { transform: rotate(45deg); }.exit-line.second { transform: rotate(-45deg); }
.progress-copy { display: flex; flex: 1; align-items: center; justify-content: center; gap: var(--space-2); color: var(--muted); font-size: var(--font-meta); line-height: 1.45; white-space: nowrap; }.progress-mode { flex-shrink: 0; color: var(--ink); font-weight: 600; }
.progress-copy .timer { min-width: 76rpx; color: var(--ink); font-variant-numeric: tabular-nums; }
.progress-copy .timer.urgent { color: var(--clay); font-weight: 650; }
.sheet-entry { flex: 0 0 160rpx; min-height: var(--touch-min); gap: 8rpx; background: transparent; color: var(--ink); font-size: var(--font-meta); white-space: nowrap; }
.sheet-entry.is-disabled { color: var(--disabled); }
.progress-track { height: 5rpx; overflow: hidden; background: var(--surface-quiet); }.progress-value { height: 100%; background: var(--ink); transition: width .2s ease; }
.progress-value.clay { background: var(--clay); }
.progress-value.gold { background: var(--gold); }
.practice-meta { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); border-bottom: 2rpx solid var(--line); }
.practice-meta-actions { display: flex; flex: 1; min-width: 0; align-items: center; justify-content: space-between; gap: var(--space-3); }
.practice-meta-actions .mark-button { min-height: var(--touch-min); margin-left: auto; padding: 0; gap: 8rpx; background: transparent; color: var(--muted); font-size: var(--font-meta); white-space: nowrap; }.mark-button.is-marked { color: var(--clay); }
.question-loading { padding-top: 62rpx; }.question-loading-line { height: 28rpx; margin-bottom: 28rpx; border-radius: 8rpx; background: var(--surface-quiet); }.question-loading-line.is-short { width: 30%; height: 18rpx; }.question-loading-line.is-block { height: 122rpx; }
.write-error { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-top: var(--space-4); padding: var(--space-3) 0; border-top: 2rpx solid var(--line); color: var(--danger); font-size: var(--font-meta); }
.write-error-copy { flex: 1; }
.write-error-action { min-width: 160rpx; min-height: var(--touch-min); border-bottom: 2rpx solid var(--ink); border-radius: 0; background: transparent; color: var(--ink); font-size: var(--font-meta); }
.answer-actions { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; gap: var(--space-2); padding: var(--space-3) var(--page-gutter) calc(var(--space-3) + env(safe-area-inset-bottom)); border-top: 2rpx solid var(--line); background: var(--paper); }
.previous { flex: 0 0 176rpx; min-height: var(--touch-min); border: 2rpx solid var(--ink); background: transparent; color: var(--ink); font-size: var(--font-body); }.previous.is-disabled { border-color: var(--line); color: var(--disabled); }
.submit { flex: 1; min-height: var(--touch-min); background: var(--ink); color: var(--on-accent); font-size: var(--font-body); font-weight: 650; }.submit.is-disabled { background: var(--disabled-surface); color: var(--disabled-text); }
.practice-nav { padding-right: 170rpx; }
.exit { --button-width: 64rpx; flex: 0 0 64rpx; width: 64rpx; }
.progress-copy { min-width: 0; flex-wrap: wrap; gap: 0 12rpx; font-size: var(--font-meta); }
.progress-mode { width: 100%; text-align: center; }
.write-error-action { display: flex; align-items: center; justify-content: center; }
