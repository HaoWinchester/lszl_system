<view class="page-shell practice-page" style="{{appearanceStyle}}padding-top: {{statusBarHeight}}px">
  <view class="practice-nav">
    <button class="exit" bindtap="onExit" disabled="{{busy}}" aria-label="{{policy.allowPause ? '暂停并退出' : '交卷并退出'}}"><ui-icon name="close" /></button>
    <view class="progress-copy"><text class="progress-mode">{{modeTitle}}</text><text>{{currentIndex + 1}} / {{session.questions.length}}</text><text wx:if="{{policy.showTimer}}" class="timer {{timerUrgent ? 'urgent' : ''}}">{{timerLabel}}</text></view>
  </view>
  <view class="progress-track"><view class="progress-value {{policy.accent}}" style="width: {{progressPercent}}%"></view></view>
  <view wx:if="{{!loading && !loadError}}" class="practice-meta">
    <save-status wx:if="{{saveState !== 'local'}}" state="{{saveState}}" />
    <view class="practice-meta-actions">
      <label wx:if="{{session.mode === 'practice'}}" class="setting-toggle"><text>显示答案</text><view class="setting-switch-slot"><switch class="setting-switch" checked="{{showAnswers}}" bindchange="onShowAnswers" color="{{appearanceColors.ink}}" /></view></label>
      <button class="mark-button {{marked ? 'is-marked' : ''}}" disabled="{{busy}}" bindtap="onMark"><ui-icon name="bookmark" size="30" color="{{marked ? 'clay' : 'muted'}}" />{{marked ? '已标记' : '标记此题'}}</button>
    </view>
  </view>
  <view wx:if="{{draftError}}" class="inline-notice" role="alert"><text>{{draftError}}</text></view>
  <view wx:if="{{!loading && !loadError && session.mode !== 'practice'}}" class="game-status"><text>生命 {{health}} / {{maxHealth}}</text><text>连对 {{streak}}</text><text>经验 {{experience}}</text></view>
  <text wx:if="{{feedback}}" class="answer-feedback">{{feedback}}</text>

  <empty-state wx:if="{{navigationError}}" title="页面未打开" body="{{navigationError}}" action-text="重试跳转" bind:action="retryNavigation" />
  <view wx:elif="{{loading}}" class="question-loading"><view class="question-loading-line is-short"></view><view class="question-loading-line"></view><view class="question-loading-line is-block"></view><view class="question-loading-line is-block"></view></view>
  <empty-state wx:elif="{{loadError}}" title="题目没有载入" body="{{loadError}}" action-text="重新加载" bind:action="loadSession" />
  <question-view wx:else question="{{currentQuestion}}" selected-ids="{{selectedIds}}" selected-pairs="{{selectedPairs}}" submitted="{{submitted || busy || showAnswers || writeError !== ''}}" show-result="{{showResult}}" show-analysis="{{showAnalysis}}" bind:change="onAnswerChange" />

  <button wx:if="{{!loading && !loadError && currentQuestion.type === 'matching' && !submitted && !showAnswers}}" class="primary-button" disabled="{{busy || !matchingComplete}}" bindtap="onConfirmMatching">确认配对答案</button>
  <view wx:if="{{writeError && !loading && !loadError}}" class="write-error"><text class="write-error-copy">{{writeError}}</text><button class="write-error-action" bindtap="retryWrites">重试同步</button></view>
  <view wx:if="{{!loading && !loadError && !navigationTarget}}" class="answer-actions">
    <button class="sheet-entry {{busy ? 'is-disabled' : ''}}" bindtap="onOpenSheet" disabled="{{busy}}" aria-label="打开答题卡"><ui-icon name="sheet" size="28" /><text>答题卡</text></button>
    <button class="previous {{currentIndex === 0 || busy ? 'is-disabled' : ''}}" disabled="{{currentIndex === 0 || busy}}" bindtap="onPrevious">上一题</button>
    <button class="submit {{busy ? 'is-disabled' : ''}}" loading="{{busy}}" disabled="{{busy}}" bindtap="onNext">{{nextActionLabel}}</button>
  </view>
</view>

<answer-sheet style="{{appearanceStyle}}" open="{{sheetOpen}}" items="{{sheetItems}}" complete-label="检查并交卷" bind:close="onCloseSheet" bind:select="onSheetSelect" bind:complete="onComplete" />
<app-dialog id="app-dialog" style="{{appearanceStyle}}" />
