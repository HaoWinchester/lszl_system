:host { display: block; }
.tab-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; height: calc(120rpx + env(safe-area-inset-bottom)); padding: var(--space-1) var(--space-6) env(safe-area-inset-bottom); border-top: 2rpx solid var(--line); background: var(--paper); }
.tab-item { --button-width: auto; display: flex; align-items: center; justify-content: center; flex: 1; flex-direction: column; gap: var(--space-2); min-height: var(--touch-min); margin: 0; padding: 0; border-radius: 0; background: transparent; color: var(--muted); font-size: var(--font-meta); line-height: 1.3; transition: color 160ms ease, opacity 160ms ease; }
.tab-item::after { border: 0; }
.tab-item.active { color: var(--ink); }
.tab-item-pressed { opacity: .62; }
.tab-label { line-height: 1.3; }
.tab-dialog-mask { position: absolute; z-index: 1; inset: 0; background: var(--mask); }

@media (prefers-reduced-motion: reduce) { .tab-item { transition: none; } }
