<view class="tab-bar" role="tablist" aria-label="主导航">
  <button
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
    role="tab"
    aria-selected="{{selected === index}}"
    aria-label="{{item.label}}"
  >
    <view class="tab-icon {{item.icon}}-icon">
      <view wx:if="{{item.icon === 'home'}}" class="home-roof"></view>
    </view>
    <text class="tab-label">{{item.label}}</text>
  </button>
</view>
