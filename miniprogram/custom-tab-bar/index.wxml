<view class="tab-bar" style="{{appearanceStyle}}" role="tablist" aria-label="主导航" aria-hidden="{{dialogOpen}}">
  <button
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-item {{selected === index ? 'active' : ''}}"
    hover-class="tab-item-pressed"
    hover-stay-time="80"
    data-index="{{index}}"
    bindtap="switchTab"
    role="tab"
    aria-selected="{{selected === index}}"
    aria-label="{{item.label}}"
  >
    <ui-icon name="{{item.icon}}" size="44" color="{{selected === index ? 'ink' : 'muted'}}" />
    <text class="tab-label">{{item.label}}</text>
  </button>
  <view wx:if="{{dialogOpen}}" class="tab-dialog-mask" catchtap="noop" catchtouchmove="noop" />
</view>
