# 佩奇老师 lszl.aihuanpu.com 生产环境变量
# 拷贝为 .env.prod（与 docker-compose.prod.yml 同目录）并填真实值。
# 生成 SECRET_KEY：openssl rand -hex 32

SECRET_KEY=请用 openssl rand -hex 32 生成
POSTGRES_DB=kg_graph
POSTGRES_USER=kg
POSTGRES_PASSWORD=请改成强密码
QUESTION_CATALOG_CUTOVER_ENABLED=true

# 微信 Native 支付：私钥/公钥 PEM 只保存在服务器 /opt/lszl/secrets/wechatpay/，禁止提交。
WECHAT_PAY_ENABLE_DEMO=false
WECHAT_PAY_MCH_ID=1115389574
WECHAT_PAY_API_V3_KEY=请在服务器填写32位密钥
WECHAT_PAY_MCH_SERIAL_NO=7A4E4B6E8A04843F94F5B680AEE1E5343F232066
WECHAT_PAY_MCH_PRIVATE_KEY_FILE=/run/secrets/wechatpay/apiclient_key.pem
WECHAT_PAY_WX_PUBLIC_KEY_FILE=/run/secrets/wechatpay/wechatpay_pub.pem
WECHAT_PAY_WX_PUBLIC_KEY_ID=PUB_KEY_ID_0111153895742026071700191588001800
WECHAT_PAY_APP_ID=wx2d8ea5212f8d9f4f
WECHAT_PAY_NOTIFY_URL=https://lszl.aihuanpu.com/api/v1/subscriptions/wechat-pay/notify
