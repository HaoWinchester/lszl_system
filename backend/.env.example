# 运行环境：dev | prod
ENV=dev

# itsdangerous 签名密钥（生产务必更换为随机长串）
SECRET_KEY=dev-only-change-me

# PostgreSQL 连接串（async）。
# 本机 Homebrew PG 监听 /tmp Unix socket（不监听 TCP），所以用 ?host=/tmp。
# 默认用户 menghao、无密码（trust）；库名前是单 /，host 走 query 参数。
DATABASE_URL=postgresql+asyncpg://menghao@/kg_graph_dev?host=/tmp

# 允许的前端来源（CORS）。allow_credentials=True 时不能用 *。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 微信网站应用凭证：仅部署服务器使用，禁止提交真实值。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://lszl.aihuanpu.com/api/v1/auth/wechat/callback
WECHAT_ENABLE_OFFICIAL=false
WECHAT_ENABLE_DEMO=true
