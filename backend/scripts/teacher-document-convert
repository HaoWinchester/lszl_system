#!/usr/bin/env python3
"""Forward a bounded Office file to the dedicated no-egress converter container."""
import http.client
import os
from pathlib import Path
import sys
from urllib.parse import urlparse
source,destination,target=sys.argv[1:]
if target not in ('docx','pptx'): raise SystemExit('Unsupported conversion')
path=Path(source)
if path.stat().st_size>20*1024*1024: raise SystemExit('Oversized Office file')
url=urlparse(os.environ.get('TEACHER_DOCUMENT_CONVERTER_URL','http://document-converter:8090'))
connection=http.client.HTTPConnection(url.hostname,url.port or 8090,timeout=115)
try:
    connection.putrequest('POST','/convert?target='+target)
    connection.putheader('Content-Type','application/octet-stream')
    connection.putheader('Content-Length',str(path.stat().st_size));connection.endheaders()
    with path.open('rb') as file:
        while chunk:=file.read(65536): connection.send(chunk)
    response=connection.getresponse()
    if response.status!=200: raise SystemExit('Office conversion rejected')
    output=Path(destination)/(path.stem+'.'+target)
    output.parent.mkdir(parents=True,exist_ok=True)
    size=0
    with output.open('wb') as file:
        while chunk:=response.read(65536):
            size+=len(chunk)
            if size>20*1024*1024: raise SystemExit('Oversized converted file')
            file.write(chunk)
finally: connection.close()
