{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg.local/schemas/assessment-paper-schema-v1.json",
  "title": "Assessment Paper Schema v1",
  "type": "object",
  "required": ["id", "schemaVersion", "title", "subjectId", "sections", "settings", "status", "version", "authorship"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": 1},
    "title": {"type": "string", "minLength": 1},
    "subjectId": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "order", "items"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "order": {"type": "number"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["activityId", "score", "order"],
              "properties": {
                "activityId": {"type": "string", "minLength": 1},
                "score": {"type": "number", "minimum": 0},
                "order": {"type": "number"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "settings": {
      "type": "object",
      "required": ["durationMinutes", "passingScore", "shuffleActivities", "shuffleOptions", "attemptsAllowed", "showAnswersAfterSubmit"],
      "properties": {
        "durationMinutes": {"type": "number", "minimum": 0},
        "passingScore": {"type": "number", "minimum": 0},
        "shuffleActivities": {"type": "boolean"},
        "shuffleOptions": {"type": "boolean"},
        "attemptsAllowed": {"type": "integer", "minimum": 1},
        "showAnswersAfterSubmit": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "status": {"enum": ["draft", "published", "archived"]},
    "version": {"type": "integer", "minimum": 1},
    "authorship": {"type": "object"}
  },
  "additionalProperties": true
}
