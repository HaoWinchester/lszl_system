{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/subject-schema-v1.json",
  "title": "Subject Schema v1",
  "type": "object",
  "required": ["id", "code", "name", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "code": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,31}$"},
    "name": {
      "type": "object",
      "required": ["zh", "en"],
      "properties": {"zh": {"type": "string", "minLength": 1}, "en": {"type": "string"}},
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "properties": {"zh": {"type": "string"}, "en": {"type": "string"}},
      "additionalProperties": false
    },
    "defaultTaxonomyId": {"type": "string"},
    "status": {"enum": ["active", "inactive"]},
    "sortOrder": {"type": "number"},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"},
    "createdBy": {"type": ["object", "null"]},
    "updatedBy": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
