{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/activity-schema-v1.json",
  "title": "Activity Schema v1 — Chinese assessment with optional English display",
  "type": "object",
  "required": [
    "id",
    "type",
    "schemaVersion",
    "content",
    "answer",
    "explanation",
    "assessment",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "type": {
      "type": "string",
      "enum": [
        "single_choice",
        "keyword_recognition",
        "ordering",
        "matching",
        "open_response",
        "memory_match",
        "deep_recall",
        "multi_question_induction",
        "knowledge_graph",
        "part_challenge"
      ]
    },
    "schemaVersion": {
      "const": 1
    },
    "content": {
      "$ref": "#/$defs/localizedPayload"
    },
    "answer": {
      "type": "object"
    },
    "explanation": {
      "$ref": "#/$defs/localizedExplanation"
    },
    "assessment": {
      "type": "object",
      "required": [
        "language"
      ],
      "properties": {
        "language": {
          "const": "zh"
        }
      },
      "additionalProperties": true
    },
    "config": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "required": [
        "translationStatus"
      ],
      "properties": {
        "runtimeType": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "repeatOf": {
          "type": "string"
        },
        "translationStatus": {
          "enum": [
            "zh_only",
            "bilingual"
          ]
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "knowledge": {
          "type": "object",
          "required": [
            "taxonomyId",
            "taxonomyVersion",
            "primaryNodeId",
            "relatedNodeIds",
            "mappingStatus"
          ],
          "properties": {
            "taxonomyId": {
              "type": "string",
              "minLength": 1
            },
            "taxonomyVersion": {
              "type": "integer",
              "minimum": 1
            },
            "primaryNodeId": {
              "type": [
                "string",
                "null"
              ]
            },
            "relatedNodeIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "mappingStatus": {
              "enum": [
                "unmapped",
                "suggested",
                "confirmed"
              ]
            },
            "pathSnapshot": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "authorship": {
          "type": "object",
          "required": [
            "createdByUserId",
            "createdByName",
            "createdAt",
            "updatedByUserId",
            "updatedByName",
            "updatedAt"
          ],
          "properties": {
            "createdByUserId": {
              "type": "string",
              "minLength": 1
            },
            "createdByName": {
              "type": "string"
            },
            "createdAt": {
              "type": "string"
            },
            "updatedByUserId": {
              "type": "string",
              "minLength": 1
            },
            "updatedByName": {
              "type": "string"
            },
            "updatedAt": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "ownership": {
          "type": "object",
          "properties": {
            "ownerUserId": {
              "type": "string"
            },
            "organizationId": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "lifecycle": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "draft",
                "submitted",
                "approved",
                "archived"
              ]
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "sourceApplication": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "single_choice"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/localizedSingleChoice"
          },
          "answer": {
            "type": "object",
            "required": [
              "optionId"
            ],
            "properties": {
              "optionId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "keyword_recognition"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/localizedKeyword"
          },
          "answer": {
            "type": "object",
            "required": [
              "segmentIds",
              "requiredSelectionCount"
            ],
            "properties": {
              "segmentIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "requiredSelectionCount": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ordering"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/localizedOrdering"
          },
          "answer": {
            "type": "object",
            "required": [
              "itemIds"
            ],
            "properties": {
              "itemIds": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "matching"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/localizedPairs"
          },
          "answer": {
            "type": "object",
            "required": [
              "matches"
            ],
            "properties": {
              "matches": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "leftId",
                    "rightId"
                  ],
                  "properties": {
                    "leftId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "rightId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "memory_match"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/localizedPairs"
          },
          "answer": {
            "type": "object",
            "required": [
              "matches"
            ],
            "properties": {
              "matches": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "leftId",
                    "rightId"
                  ],
                  "properties": {
                    "leftId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "rightId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "open_response"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/localizedOpenResponse"
          },
          "answer": {
            "type": "object",
            "required": [
              "evaluationMode",
              "minLength",
              "maxLength",
              "acceptedConcepts"
            ],
            "properties": {
              "evaluationMode": {
                "type": "string",
                "minLength": 1
              },
              "minLength": {
                "type": "integer",
                "minimum": 1
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1
              },
              "acceptedConcepts": {
                "type": "object",
                "required": [
                  "zh"
                ],
                "properties": {
                  "zh": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/concept"
                    }
                  },
                  "en": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/concept"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "single_choice"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "runtimeType": {
                "const": "choice"
              },
              "adapter": {
                "const": "single_choice"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "keyword_recognition"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "runtimeType": {
                "const": "keyword"
              },
              "adapter": {
                "const": "keyword_recognition"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ordering"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "runtimeType": {
                "const": "ordering"
              },
              "adapter": {
                "const": "ordering"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "matching"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "runtimeType": {
                "const": "matching"
              },
              "adapter": {
                "const": "matching"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "open_response"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "runtimeType": {
                "const": "open_text"
              },
              "adapter": {
                "const": "open_response"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "memory_match"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "runtimeType": {
                "const": "memory_match"
              },
              "adapter": {
                "const": "memory_match"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "deep_recall"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "runtimeType": {
                "const": "deep_recall"
              },
              "adapter": {
                "const": "legacy_passthrough"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "multi_question_induction"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "runtimeType": {
                "const": "multi_question_induction"
              },
              "adapter": {
                "const": "legacy_passthrough"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knowledge_graph"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "runtimeType": {
                "const": "knowledge_graph"
              },
              "adapter": {
                "const": "legacy_passthrough"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "part_challenge"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "runtimeType": {
                "const": "part_challenge"
              },
              "adapter": {
                "const": "legacy_passthrough"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "localizedPayload": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "object",
          "minProperties": 1
        },
        "en": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "localizedExplanation": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "$ref": "#/$defs/explanationRecord"
        },
        "en": {
          "anyOf": [
            {
              "$ref": "#/$defs/explanationRecord"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "explanationRecord": {
      "type": "object",
      "properties": {
        "short": {
          "type": "string"
        },
        "detailed": {
          "type": "string"
        },
        "incorrect": {
          "type": "string"
        },
        "general": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "feedback": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "singleChoicePayload": {
      "type": "object",
      "required": [
        "stem",
        "options"
      ],
      "properties": {
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      },
      "additionalProperties": true
    },
    "localizedSingleChoice": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "$ref": "#/$defs/singleChoicePayload"
        },
        "en": {
          "anyOf": [
            {
              "$ref": "#/$defs/singleChoicePayload"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "keywordPayload": {
      "type": "object",
      "required": [
        "instruction",
        "segments"
      ],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "localizedKeyword": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "$ref": "#/$defs/keywordPayload"
        },
        "en": {
          "anyOf": [
            {
              "$ref": "#/$defs/keywordPayload"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "orderItem": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "orderingPayload": {
      "type": "object",
      "required": [
        "instruction",
        "items"
      ],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/orderItem"
          }
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "localizedOrdering": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "$ref": "#/$defs/orderingPayload"
        },
        "en": {
          "anyOf": [
            {
              "$ref": "#/$defs/orderingPayload"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "pair": {
      "type": "object",
      "required": [
        "id",
        "left",
        "right"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "left": {
          "type": "string",
          "minLength": 1
        },
        "right": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "pairsPayload": {
      "type": "object",
      "required": [
        "instruction",
        "pairs"
      ],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pair"
          }
        }
      },
      "additionalProperties": true
    },
    "localizedPairs": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "$ref": "#/$defs/pairsPayload"
        },
        "en": {
          "anyOf": [
            {
              "$ref": "#/$defs/pairsPayload"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "openResponsePayload": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "type": "string"
        },
        "referenceAnswer": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "localizedOpenResponse": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "$ref": "#/$defs/openResponsePayload"
        },
        "en": {
          "anyOf": [
            {
              "$ref": "#/$defs/openResponsePayload"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "concept": {
      "type": "object",
      "required": [
        "id",
        "acceptedExpressions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "acceptedExpressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missingHint": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
